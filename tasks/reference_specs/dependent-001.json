{
  "version": "0.2",
  "title": "Address form",
  "entry": "address",
  "state": {
    "address": {
      "type": "object",
      "default": {
        "country": "US",
        "region": ""
      }
    },
    "postalCode": {
      "type": "string",
      "default": ""
    },
    "submitted": {
      "type": "boolean",
      "default": false
    }
  },
  "screens": [
    {
      "id": "address",
      "title": "Enter Address",
      "children": [
        {
          "kind": "heading",
          "id": "title",
          "label": "Shipping Address"
        },
        {
          "kind": "select",
          "id": "countrySelect",
          "label": "Country",
          "bind": "address.country",
          "options": ["US", "CA", "UK", "India", "Other"]
        },
        {
          "kind": "field",
          "id": "regionField",
          "label": "Region",
          "bind": "address.region"
        },
        {
          "kind": "field",
          "id": "postalField",
          "label": "Postal Code",
          "bind": "postalCode",
          "enabledWhen": {
            "op": "not",
            "clauses": [
              {
                "op": "eq",
                "left": "address.country",
                "right": "Other"
              }
            ]
          }
        },
        {
          "kind": "button",
          "id": "submitBtn",
          "label": "Submit",
          "enabledWhen": {
            "op": "nonempty",
            "left": "address.region"
          },
          "action": [
            {
              "op": "set",
              "target": "submitted",
              "value": true
            }
          ]
        },
        {
          "kind": "banner",
          "id": "successBanner",
          "tone": "success",
          "label": "Address saved",
          "visibleWhen": {
            "op": "truthy",
            "left": "submitted"
          }
        }
      ]
    }
  ]
}
