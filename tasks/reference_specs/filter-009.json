        }
      ]
    }
  },
  "screens": [
    {
      "id": "table",
      "title": "Invoices",
      "children": [
        {
          "kind": "heading",
          "id": "title",
          "label": "Invoices"
        },
        {
          "kind": "select",
          "id": "statusFilter",
          "label": "Status",
          "bind": "filter.status"
        },
        {
          "kind": "list",
          "id": "invoiceList",
          "of": "invoices",
          "rowLabel": "id",
          "rowAction": {
            "op": "navigate",
            "target": "detail"
          },
          "filterWhen": {
            "op": "or",
            "clauses": [
              {
                "op": "eq",
                "left": "$row.status",
                "right": "$state.filter.status"
              },
              {
                "op": "eq",
                "left": "$state.filter.status",
                "right": "All"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "detail",
      "title": "Invoice detail",
      "children": [
        {
          "kind": "heading",
          "id": "detailTitle",
          "label": "Invoice"
        },
        {
          "kind": "button",
          "id": "back",
          "label": "Back",
          "action": [
            {
              "op": "navigate",
              "target": "table"
            }
          ]
        }
      ]
    }
  ]
}
