{
  "version": "0.2",
  "title": "Search",
  "entry": "search",
  "state": {
    "query": {
      "type": "string",
      "default": ""
    },
    "route": {
      "type": "string",
      "default": "search"
    }
  },
  "collections": {
    "results": {
      "fields": {
        "title": { "type": "string" },
        "url": { "type": "string" },
        "description": { "type": "string" }
      },
      "seed": [
        {
          "title": "Soup recipes for beginners",
          "url": "https://recipes.example.com/soup",
          "description": "Easy soup recipes anyone can make."
        },
        {
          "title": "HostShift Documentation",
          "url": "https://hostshift.dev/docs",
          "description": "Learn how to build host-independent UIs."
        },
        {
          "title": "React Reference",
          "url": "https://reactjs.org",
          "description": "A JavaScript library for building user interfaces."
        },
        {
          "title": "SwiftUI Tutorials",
          "url": "https://developer.apple.com/xcode/swiftui/",
          "description": "Better apps. Less code."
        }
      ]
    }
  },
  "screens": [
    {
      "id": "search",
      "title": "Search",
      "children": [
        {
          "kind": "heading",
          "id": "searchHeader",
          "label": "Search Engine"
        },
        {
          "kind": "field",
          "id": "searchInput",
          "label": "Search query",
          "bind": "query"
        },
        {
          "kind": "list",
          "id": "searchResults",
          "of": "results",
          "rowLabel": "title",
          "a11yLabel": "Search Results",
          "rowAction": [
            { "op": "set", "target": "route", "value": "detail" },
            { "op": "navigate", "target": "detail" }
          ]
        },
        {
          "kind": "banner",
          "id": "noResultsBanner",
          "tone": "empty",
          "label": "No results found for your query.",
          "visibleWhen": {
            "op": "eq",
            "left": "results.length",
            "right": 0
          }
        }
      ]
    },
    {
      "id": "detail",
      "title": "Result Detail",
      "children": [
        {
          "kind": "heading",
          "id": "detailTitle",
          "label": "Result Details"
        },
        {
          "kind": "button",
          "id": "backToSearch",
          "label": "Back to Search",
          "action": [
            { "op": "set", "target": "route", "value": "search" },
            { "op": "navigate", "target": "search" }
          ]
        }
      ]
    }
  ]
}
