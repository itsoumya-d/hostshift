{
  "version": "0.2",
  "title": "Account Setup Wizard",
  "entry": "step1",
  "state": {
    "username": {
      "type": "string",
      "default": ""
    },
    "plan": {
      "type": "enum",
      "options": ["Free", "Pro", "Enterprise"],
      "default": "Free"
    },
    "wizard": {
      "type": "object",
      "default": {
        "completed": false
      }
    }
  },
  "collections": {
    "accounts": {
      "fields": {
        "username": { "type": "string" },
        "plan": { "type": "string" }
      },
      "seed": []
    }
  },
  "screens": [
    {
      "id": "step1",
      "title": "Step 1: Username",
      "children": [
        {
          "kind": "heading",
          "id": "step1Title",
          "label": "Create Your Account"
        },
        {
          "kind": "field",
          "id": "username",
          "label": "Username",
          "bind": "username"
        },
        {
          "kind": "button",
          "id": "nextToStep2",
          "label": "Next",
          "enabledWhen": {
            "op": "nonempty",
            "left": "username"
          },
          "action": {
            "op": "navigate",
            "target": "step2"
          }
        }
      ]
    },
    {
      "id": "step2",
      "title": "Step 2: Choose Plan",
      "children": [
        {
          "kind": "heading",
          "id": "step2Title",
          "label": "Select Your Plan"
        },
        {
          "kind": "select",
          "id": "planSelect",
          "label": "Plan",
          "bind": "plan",
          "options": ["Free", "Pro", "Enterprise"]
        },
        {
          "kind": "button",
          "id": "backToStep1",
          "label": "Back",
          "action": {
            "op": "navigate",
            "target": "step1"
          }
        },
        {
          "kind": "button",
          "id": "nextToStep3",
          "label": "Review",
          "action": {
            "op": "navigate",
            "target": "step3"
          }
        }
      ]
    },
    {
      "id": "step3",
      "title": "Step 3: Review",
      "children": [
        {
          "kind": "heading",
          "id": "step3Title",
          "label": "Review Your Account"
        },
        {
          "kind": "text",
          "id": "reviewUsername",
          "label": "Username",
          "bind": "username"
        },
        {
          "kind": "text",
          "id": "reviewPlan",
          "label": "Plan",
          "bind": "plan"
        },
        {
          "kind": "button",
          "id": "backToStep2",
          "label": "Back",
          "action": {
            "op": "navigate",
            "target": "step2"
          }
        },
        {
          "kind": "button",
          "id": "createAccount",
          "label": "Create Account",
          "action": [
            {
              "op": "append",
              "target": "accounts",
              "value": {
                "username": "$state.username",
                "plan": "$state.plan"
              }
            },
            {
              "op": "set",
              "target": "wizard.completed",
              "value": true
            }
          ]
        },
        {
          "kind": "banner",
          "id": "completionBanner",
          "tone": "success",
          "label": "Account created successfully!",
          "visibleWhen": {
            "op": "truthy",
            "left": "wizard.completed"
          }
        }
      ]
    }
  ]
}
