{
  "version": "0.2",
  "title": "Settings",
  "entry": "settings",
  "state": {
    "notifications": {
      "type": "object",
      "default": {
        "master": false,
        "email": false,
        "sms": false,
        "push": false
      }
    },
    "darkMode": {
      "type": "boolean",
      "default": false
    },
    "locationServices": {
      "type": "boolean",
      "default": false
    }
  },
  "screens": [
    {
      "id": "settings",
      "title": "Application Settings",
      "children": [
        {
          "kind": "heading",
          "id": "settingsTitle",
          "label": "General Settings"
        },
        {
          "kind": "toggle",
          "id": "darkMode",
          "label": "Dark Mode",
          "bind": "darkMode"
        },
        {
          "kind": "toggle",
          "id": "locationServices",
          "label": "Location Services",
          "bind": "locationServices"
        },
        {
          "kind": "heading",
          "id": "notificationsTitle",
          "label": "Notifications"
        },
        {
          "kind": "toggle",
          "id": "master",
          "label": "Enable Notifications",
          "bind": "notifications.master"
        },
        {
          "kind": "toggle",
          "id": "email",
          "label": "Email Notifications",
          "bind": "notifications.email",
          "visibleWhen": {
            "op": "truthy",
            "left": "notifications.master"
          }
        },
        {
          "kind": "toggle",
          "id": "sms",
          "label": "SMS Notifications",
          "bind": "notifications.sms",
          "visibleWhen": {
            "op": "truthy",
            "left": "notifications.master"
          }
        },
        {
          "kind": "toggle",
          "id": "push",
          "label": "Push Notifications",
          "bind": "notifications.push",
          "visibleWhen": {
            "op": "truthy",
            "left": "notifications.master"
          }
        },
        {
          "kind": "button",
          "id": "resetButton",
          "label": "Reset to defaults",
          "action": [
            { "op": "clear", "target": "notifications.master" },
            { "op": "clear", "target": "notifications.email" },
            { "op": "clear", "target": "notifications.sms" },
            { "op": "clear", "target": "notifications.push" },
            { "op": "clear", "target": "darkMode" },
            { "op": "clear", "target": "locationServices" }
          ]
        }
      ]
    }
  ]
}
