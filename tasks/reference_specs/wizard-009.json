{
  "version": "0.2",
  "title": "A three-step wizard ",
  "entry": "main",
  "state": {
    "wizard": {
      "type": "object",
      "default": {
        "completed": false
      }
    },
    "new_signups_email": {
      "type": "string",
      "default": ""
    }
  },
  "collections": {
    "signups": {
      "fields": {
        "email": {
          "type": "string"
        }
      },
      "seed": [
        {
          "email": "ok@corp.com"
        }
      ]
    }
  },
  "screens": [
    {
      "id": "main",
      "title": "Main Screen",
      "children": [
        {
          "kind": "heading",
          "id": "title",
          "label": "Main"
        },
        {
          "kind": "toggle",
          "id": "wizardcompleted",
          "label": "Wizard.completed",
          "bind": "wizard.completed"
        },
        {
          "kind": "field",
          "id": "new_signups_email",
          "label": "signups email",
          "bind": "new_signups_email"
        },
        {
          "kind": "button",
          "id": "submitBtn",
          "label": "Submit",
          "action": [
            {
              "op": "set",
              "target": "wizard.completed",
              "value": true
            },
            {
              "op": "append",
              "target": "signups",
              "value": {
                "email": "$state.new_signups_email"
              }
            }
          ]
        }
      ]
    }
  ]
}