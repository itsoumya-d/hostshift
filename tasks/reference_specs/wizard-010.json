{
  "version": "0.2",
  "title": "A wizard that preser",
  "entry": "main",
  "state": {
    "wizard": {
      "type": "object",
      "default": {
        "completed": false
      }
    },
    "new_preferences_channels": {
      "type": "string",
      "default": ""
    }
  },
  "collections": {
    "preferences": {
      "fields": {
        "channels": {
          "type": "string"
        }
      },
      "seed": [
        {
          "channels": [
            "Email",
            "SMS"
          ]
        }
      ]
    }
  },
  "screens": [
    {
      "id": "main",
      "title": "Main Screen",
      "children": [
        {
          "kind": "heading",
          "id": "title",
          "label": "Main"
        },
        {
          "kind": "toggle",
          "id": "wizardcompleted",
          "label": "Wizard.completed",
          "bind": "wizard.completed"
        },
        {
          "kind": "field",
          "id": "new_preferences_channels",
          "label": "preferences channels",
          "bind": "new_preferences_channels"
        },
        {
          "kind": "button",
          "id": "submitBtn",
          "label": "Submit",
          "action": [
            {
              "op": "set",
              "target": "wizard.completed",
              "value": true
            },
            {
              "op": "append",
              "target": "preferences",
              "value": {
                "channels": "$state.new_preferences_channels"
              }
            }
          ]
        }
      ]
    }
  ]
}