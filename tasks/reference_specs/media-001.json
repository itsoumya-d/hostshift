{
  "version": "0.2",
  "title": "Photo Gallery",
  "entry": "gallery",
  "state": {
    "selectedPhotoName": {
      "type": "string",
      "default": ""
    },
    "selectedPhotoFavourite": {
      "type": "boolean",
      "default": false
    },
    "confirmDeleteVisible": {
      "type": "boolean",
      "default": false
    }
  },
  "collections": {
    "photos": {
      "fields": {
        "name": { "type": "string" },
        "favourite": { "type": "boolean" }
      },
      "seed": [
        { "name": "sunset", "favourite": false },
        { "name": "harbour", "favourite": false },
        { "name": "mountain", "favourite": false },
        { "name": "forest", "favourite": true },
        { "name": "river", "favourite": false },
        { "name": "skyline", "favourite": false }
      ]
    }
  },
  "screens": [
    {
      "id": "gallery",
      "title": "My Photos",
      "children": [
        {
          "kind": "heading",
          "id": "galleryTitle",
          "label": "My Photos"
        },
        {
          "kind": "list",
          "id": "photoGrid",
          "of": "photos",
          "rowLabel": "name",
          "a11yLabel": "Photos",
          "rowAction": [
            { "op": "set", "target": "selectedPhotoName", "value": "$row.name" },
            { "op": "set", "target": "selectedPhotoFavourite", "value": "$row.favourite" },
            { "op": "navigate", "target": "detail" }
          ]
        }
      ]
    },
    {
      "id": "detail",
      "title": "Photo Actions",
      "children": [
        {
          "kind": "heading",
          "id": "detailTitle",
          "label": "Photo"
        },
        {
          "kind": "text",
          "id": "photoName",
          "label": "Name",
          "bind": "selectedPhotoName"
        },
        {
          "kind": "button",
          "id": "favouriteBtn",
          "label": "Favourite",
          "visibleWhen": {
            "op": "falsy",
            "left": "selectedPhotoFavourite"
          },
          "action": [
            {
              "op": "update",
              "target": "photos",
              "value": {
                "where": { "name": "$state.selectedPhotoName" },
                "set": { "favourite": true }
              }
            },
            {
              "op": "set",
              "target": "selectedPhotoFavourite",
              "value": true
            }
          ]
        },
        {
          "kind": "button",
          "id": "deleteBtn",
          "label": "Delete",
          "action": [
            {
              "op": "set",
              "target": "confirmDeleteVisible",
              "value": true
            }
          ]
        },
        {
          "kind": "button",
          "id": "confirmDeleteBtn",
          "label": "Confirm Delete",
          "visibleWhen": {
            "op": "truthy",
            "left": "confirmDeleteVisible"
          },
          "action": [
            {
              "op": "remove",
              "target": "photos",
              "value": { "name": "$state.selectedPhotoName" }
            },
            {
              "op": "navigate",
              "target": "gallery"
            }
          ]
        },
        {
          "kind": "button",
          "id": "cancelDeleteBtn",
          "label": "Cancel",
          "visibleWhen": {
            "op": "truthy",
            "left": "confirmDeleteVisible"
          },
          "action": [
            {
              "op": "set",
              "target": "confirmDeleteVisible",
              "value": false
            }
          ]
        },
        {
          "kind": "button",
          "id": "backBtn",
          "label": "Back to Gallery",
          "action": {
            "op": "navigate",
            "target": "gallery"
          }
        }
      ]
    }
  ]
}
