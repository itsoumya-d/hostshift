  "screens": [
    {
      "id": "ledger",
      "title": "Transactions",
      "children": [
        {
          "kind": "heading",
          "id": "title",
          "label": "Transactions"
        },
        {
          "kind": "select",
          "id": "typeFilter",
          "label": "Type",
          "bind": "filter.type"
        },
        {
          "kind": "field",
          "id": "minAmount",
          "label": "Minimum amount",
          "bind": "filter.minAmount"
        },
        {
          "kind": "list",
          "id": "txnList",
          "of": "transactions",
          "rowLabel": "id",
          "filterWhen": {
            "op": "and",
            "clauses": [
              {
                "op": "or",
                "clauses": [
                  {
                    "op": "eq",
                    "left": "$row.type",
                    "right": "$state.filter.type"
                  },
                  {
                    "op": "eq",
                    "left": "$state.filter.type",
                    "right": "All"
                  }
                ]
              },
              {
                "op": "gte",
                "left": "$row.amount",
                "right": "$state.filter.minAmount"
              }
            ]
          }
        }
      ]
    }
  ]
